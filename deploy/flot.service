# Служба systemd для приложения «Управление простоями флота».
# Установка: sudo cp deploy/flot.service /etc/systemd/system/flot.service
#            sudo systemctl daemon-reload && sudo systemctl enable --now flot
[Unit]
Description=Flot (gunicorn)
After=network.target

[Service]
User=ithub
Group=www-data
WorkingDirectory=/opt/flot/prostoy
# SECRET_KEY и другие настройки — в файле .env в папке проекта («-»: если файла нет, служба всё равно запустится)
EnvironmentFile=-/opt/flot/prostoy/.env
ExecStart=/opt/flot/venv/bin/gunicorn --preload --workers 2 --threads 4 --timeout 120 --bind 127.0.0.1:5000 app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
